{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": false,
    "assets": []
  },
  "watchOptions": {
    "ignored": ["**/*.sqlite", "**/*.sqlite-journal", "**/*.sqlite-wal", "**/*.sqlite-shm", "crash.log", "uploads/*"]
  }
}