{
  "buildCommand": "sed -i \"s|__GOOGLE_CLIENT_ID__|$GOOGLE_CLIENT_ID|;s|__GOOGLE_MAPS_API_KEY__|$GOOGLE_MAPS_API_KEY|\" src/environments/environment.prod.ts && npm run build",
  "outputDirectory": "dist/farmacia-front/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
